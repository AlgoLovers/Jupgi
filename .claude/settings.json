      "Bash(git push * --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(gh repo delete*)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(diskutil * erase*)",
      "Bash(diskutil erase*)",
      "Bash(git add -f)",
      "Bash(git add -f *)",
      "Bash(git add --force)",
      "Bash(git add --force *)",
      "Read(keystore.properties)",
